rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A group is reachable only if you know its (random, 16-char) id, i.e. you have the share link.
    // Listing all groups is blocked, and groups can't be deleted from the client.
    match /groups/{groupId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'members', 'expenses'])
                            && request.resource.data.id == groupId;
      allow delete: if false;
    }
  }
}
